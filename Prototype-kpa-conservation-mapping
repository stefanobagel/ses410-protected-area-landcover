// ---------------------------------------------------------
// helpers
// ---------------------------------------------------------

function addMapLayer(obj, vis, name, shown) {

  var layer = ui.Map.Layer(
    obj,
    vis,
    name,
    shown
  );

  map.layers().add(layer);

  return layer;
}


function updateValidationLayer() {

  if (reviewPointLayer !== null) {
    map.layers().remove(reviewPointLayer);
  }

  if (validationFeatures.length > 0) {

    reviewPointLayer = addMapLayer(
      ee.FeatureCollection(validationFeatures),
      {
        color: 'cyan',
        pointSize: 6
      },
      'Human validation points',
      true
    );
  }

  validationCountLabel.setValue(
    'Reviewed validation points: ' +
    validationFeatures.length
  );
}


function updateReviewClassMenu() {

  var items = [];

  selectedClassIds
    .sort(function(a, b) {
      return a - b;
    })
    .forEach(function(id) {
      items.push(classNames[id]);
    });


  if (items.length === 0) {
    items = classNames;
  }


  reviewClassSelect.items().reset(items);

  reviewClassSelect.setValue(
    items[0],
    false
  );
}


function getClassIdFromName(name) {

  return classNames.indexOf(name);
}


// ---------------------------------------------------------
// analyze selected KPA
// ---------------------------------------------------------

function analyzeArea() {

  map.layers().reset();

  validationFeatures = [];

  updateValidationLayer();

  currentRF = null;
  currentClassified = null;
  currentTraining = null;
  currentMetrics = null;


  var siteName = siteSelect.getValue();

  var siteInfo = sites[siteName];

  var year = Number(
    yearSelect.getValue()
  );


  var feature = wdpa.filter(
    ee.Filter.eq(
      'SITE_ID',
      siteInfo.id
    )
  );


  currentGeom = feature.geometry();


  boundaryLayer = addMapLayer(
    currentGeom,
    {
      color: 'red'
    },
    siteName + ' boundary',
    true
  );


  map.centerObject(
    currentGeom,
    siteInfo.zoom
  );


  var start = ee.Date.fromYMD(
    year,
    1,
    1
  );


  var end = start.advance(
    1,
    'year'
  );


  var emb = ee.ImageCollection(
    'GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL'
  )
    .filterDate(start, end)
    .filterBounds(currentGeom);


  currentImg = emb
    .mosaic()
    .clip(currentGeom);


  embeddingLayer = addMapLayer(
    currentImg,
    {
      min: -0.3,
      max: 0.3,
      bands: [
        'A01',
        'A16',
        'A09'
      ]
    },
    'Embedding visualization',
    false
  );


  // Dynamic World
  var dw = ee.ImageCollection(
    'GOOGLE/DYNAMICWORLD/V1'
  )
    .filterDate(start, end)
    .filterBounds(currentGeom);


  var dwBands = [
    'water',
    'trees',
    'grass',
    'flooded_vegetation',
    'crops',
    'shrub_and_scrub',
    'built',
    'bare',
    'snow_and_ice'
  ];


  var probs = dw
    .select(dwBands)
    .mean();


  currentConfidence = probs
    .reduce(
      ee.Reducer.max()
    )
    .rename('confidence');


  var labels = probs
    .toArray()
    .arrayArgmax()
    .arrayGet([0])
    .rename('class')
    .toInt();


  var confidenceLimit =
    confidenceSlider.getValue();


  currentLabels = labels
    .updateMask(
      currentConfidence.gte(
        confidenceLimit
      )
    )
    .updateMask(
      currentImg
        .select('A00')
        .mask()
    );


  suggestedLayer = addMapLayer(
    currentLabels,
    {
      min: 0,
      max: 8,
      palette: classColors
    },
    'Suggested classes',
    false
  );


  confidenceLayer = addMapLayer(
    currentConfidence,
    {
      min: 0,
      max: 1
    },
    'Reference confidence',
    false
  );


  // park area
  currentGeom
    .area()
    .divide(1e6)
    .evaluate(function(area) {

      statusLabel.setValue(
        siteName +
        '\nArea: ' +
        Math.round(area).toLocaleString() +
        ' km²\nChecking embedding coverage...'
      );
    });


  // check coverage
  var valid = currentImg
    .select('A00')
    .mask()
    .unmask(0);


  valid.reduceRegion({
    reducer: ee.Reducer.mean(),

    geometry: currentGeom,

    scale: 500,

    maxPixels: 1e10,

    bestEffort: true,

    tileScale: 4

  }).get('A00')
    .evaluate(function(value) {

      var percent =
        value === null
          ? 'Unknown'
          : (value * 100).toFixed(1) + '%';


      var oldText =
        statusLabel.getValue();


      statusLabel.setValue(
        oldText +
        '\nEmbedding coverage: ' +
        percent
      );
    });


  // find which classes actually appear
  currentLabels.reduceRegion({

    reducer:
      ee.Reducer.frequencyHistogram(),

    geometry: currentGeom,

    scale: 100,

    maxPixels: 1e10,

    bestEffort: true,

    tileScale: 4

  })
    .get('class')
    .evaluate(function(hist) {

      classPanel.clear();

      selectedClassIds = [];


      if (!hist) {

        classPanel.add(
          ui.Label(
            'No high-confidence classes found.'
          )
        );

        return;
      }


      var ids = Object.keys(hist)
        .map(function(x) {
          return Number(x);
        })
        .sort(function(a, b) {
          return a - b;
        });


      ids.forEach(function(id) {

        selectedClassIds.push(id);


        var count = hist[id];


        var checkbox = ui.Checkbox({

          label:
            classNames[id] +
            '  (' +
            Number(count).toLocaleString() +
            ' sampled pixels)',

          value: true,

          onChange: function(checked) {

            if (checked) {

              if (
                selectedClassIds.indexOf(id) === -1
              ) {
                selectedClassIds.push(id);
              }

            } else {

              selectedClassIds =
                selectedClassIds.filter(
                  function(x) {
                    return x !== id;
                  }
                );
            }


            updateReviewClassMenu();
          }
        });


        classPanel.add(
          checkbox
        );
      });


      updateReviewClassMenu();
    });
}


// ---------------------------------------------------------
// train model
// ---------------------------------------------------------

function trainModel() {

  if (currentImg === null) {

    statusLabel.setValue(
      'Analyze a study area first.'
    );

    return;
  }


  if (selectedClassIds.length < 2) {

    statusLabel.setValue(
      'Select at least two land-cover classes.'
    );

    return;
  }


  var samplesPerClass =
    Number(sampleBox.getValue());


  var toValues = [];

  selectedClassIds.forEach(
    function() {
      toValues.push(1);
    }
  );


  var selectedMask =
    currentLabels.remap(
      selectedClassIds,
      toValues,
      0
    );


  var selectedLabels =
    currentLabels.updateMask(
      selectedMask
    );


  var data =
    currentImg.addBands(
      selectedLabels
    );


  var samples =
    data.stratifiedSample({

      numPoints:
        samplesPerClass,

      classBand:
        'class',

      region:
        currentGeom,

      scale:
        30,

      seed:
        42,

      geometries:
        true,

      tileScale:
        4
    });


  // this split is ONLY for an internal prototype check
  // final validation comes from human reviewed points

  samples =
    samples.randomColumn(
      'internal_split',
      42
    );


  currentTraining =
    samples.filter(
      ee.Filter.lt(
        'internal_split',
        0.80
      )
    );


  var internalCheck =
    samples.filter(
      ee.Filter.gte(
        'internal_split',
        0.80
      )
    );


  currentRF =
    ee.Classifier
      .smileRandomForest({
        numberOfTrees: 100,
        seed: 42
      })
      .train({

        features:
          currentTraining,

        classProperty:
          'class',

        inputProperties:
          currentImg.bandNames()
      });


  currentClassified =
    currentImg
      .classify(currentRF)
      .clip(currentGeom);


  if (rfLayer !== null) {

    map.layers().remove(
      rfLayer
    );
  }


  rfLayer = addMapLayer(

    currentClassified,

    {
      min: 0,
      max: 8,
      palette: classColors
    },

    'Random Forest LULC map',

    true
  );


  // prototype agreement check
  var internalTested =
    internalCheck.classify(
      currentRF
    );


  var internalMatrix =
    internalTested.errorMatrix(
      'class',
      'classification',
      ee.List(
        selectedClassIds
      ).sort()
    );


  internalMatrix
    .accuracy()
    .evaluate(function(acc) {

      statusLabel.setValue(
        'Map created.\n' +
        'Internal reference agreement: ' +
        (acc * 100).toFixed(1) +
        '%\n\n' +
        'Important: this is not the final independent accuracy result. Add human-reviewed validation points next.'
      );
    });


  print(
    'Training samples by class',
    currentTraining.aggregate_histogram(
      'class'
    )
  );


  print(
    'Internal reference check confusion matrix',
    internalMatrix
  );
}


