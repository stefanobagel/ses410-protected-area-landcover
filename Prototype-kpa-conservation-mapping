// ---------------------------------------------------------
// add human reviewed validation point
// ---------------------------------------------------------

function addValidationPoint() {

  if (
    lastClick === null
  ) {

    statusLabel.setValue(
      'Click a location on the map first.'
    );

    return;
  }


  if (
    currentTraining === null
  ) {

    statusLabel.setValue(
      'Train the model before adding validation points.'
    );

    return;
  }


  var className =
    reviewClassSelect.getValue();


  var classId =
    getClassIdFromName(
      className
    );


  var point =
    ee.Geometry.Point([
      lastClick.lon,
      lastClick.lat
    ]);


  // keep reviewed validation points away from
  // automatic training samples

  var bufferDistance =
    Number(
      validationBufferBox.getValue()
    );


  currentTraining
    .filterBounds(
      point.buffer(
        bufferDistance
      )
    )
    .size()
    .evaluate(function(nearby) {

      if (nearby > 0) {

        statusLabel.setValue(
          'That point is too close to an automatic training sample.\n' +
          'Choose another location so validation stays more independent.'
        );

        return;
      }


      validationFeatures.push(

        ee.Feature(
          point,
          {
            class: classId,
            class_name: className
          }
        )

      );


      updateValidationLayer();


      statusLabel.setValue(
        'Added validation point: ' +
        className
      );
    });
}


// ---------------------------------------------------------
// remove validation point
// ---------------------------------------------------------

function removeValidationPoint() {

  if (
    validationFeatures.length === 0
  ) {
    return;
  }


  validationFeatures.pop();

  updateValidationLayer();
}


// ---------------------------------------------------------
// calculate validation results
// ---------------------------------------------------------

function calculateValidation() {

  if (
    currentClassified === null
  ) {

    statusLabel.setValue(
      'Create the classification first.'
    );

    return;
  }


  if (
    validationFeatures.length < 2
  ) {

    statusLabel.setValue(
      'Add more human-reviewed validation points first.'
    );

    return;
  }


  var validation =
    ee.FeatureCollection(
      validationFeatures
    );


  var tested =
    currentClassified
      .sampleRegions({

        collection:
          validation,

        properties:
          ['class'],

        scale:
          10,

        geometries:
          true,

        tileScale:
          4
      });


  var orderedClasses =
    ee.List(
      selectedClassIds
    ).sort();


  var matrix =
    tested.errorMatrix(
      'class',
      'classification',
      orderedClasses
    );


  print(
    'Human reviewed validation confusion matrix',
    matrix
  );


  var ids =
    ee.List(
      selectedClassIds
    );


  var metrics =
    ee.FeatureCollection(

      ids.map(
        function(classId) {

          classId =
            ee.Number(
              classId
            );


          var tp =
            tested.filter(

              ee.Filter.and(

                ee.Filter.eq(
                  'class',
                  classId
                ),

                ee.Filter.eq(
                  'classification',
                  classId
                )

              )

            ).size();


          var fp =
            tested.filter(

              ee.Filter.and(

                ee.Filter.neq(
                  'class',
                  classId
                ),

                ee.Filter.eq(
                  'classification',
                  classId
                )

              )

            ).size();


          var fn =
            tested.filter(

              ee.Filter.and(

                ee.Filter.eq(
                  'class',
                  classId
                ),

                ee.Filter.neq(
                  'classification',
                  classId
                )

              )

            ).size();


          var precision =
            ee.Number(
              ee.Algorithms.If(

                ee.Number(tp)
                  .add(fp)
                  .eq(0),

                0,

                ee.Number(tp)
                  .divide(
                    ee.Number(tp)
                      .add(fp)
                  )
              )
            );


          var recall =
            ee.Number(
              ee.Algorithms.If(

                ee.Number(tp)
                  .add(fn)
                  .eq(0),

                0,

                ee.Number(tp)
                  .divide(
                    ee.Number(tp)
                      .add(fn)
                  )
              )
            );


          var f1 =
            ee.Number(
              ee.Algorithms.If(

                precision
                  .add(recall)
                  .eq(0),

                0,

                precision
                  .multiply(recall)
                  .multiply(2)
                  .divide(
                    precision
                      .add(recall)
                  )
              )
            );


          return ee.Feature(
            null,
            {

              class_id:
                classId,

              class_name:
                classNameDict.get(
                  classId.format()
                ),

              precision:
                precision,

              recall:
                recall,

              f1:
                f1,

              reviewed_points:
                tested
                  .filter(
                    ee.Filter.eq(
                      'class',
                      classId
                    )
                  )
                  .size()
            }
          );

        }
      )
    );


  currentMetrics =
    metrics;


  var overall =
    matrix.accuracy();


  var macroF1 =
    metrics.aggregate_mean(
      'f1'
    );


  ee.Dictionary({
    overall: overall,
    macroF1: macroF1
  })
    .evaluate(function(result) {

      statusLabel.setValue(

        'Human-reviewed results\n' +

        'Overall accuracy: ' +
        (
          result.overall * 100
        ).toFixed(1) +
        '%\n' +

        'Macro F1: ' +
        result.macroF1.toFixed(2) +
        '\n\n' +

        'See the Console for the confusion matrix and per-class results.'
      );
    });


  print(
    'Human reviewed per-class results',
    metrics
  );


  print(
    'Human reviewed macro F1',
    macroF1
  );
}


// ---------------------------------------------------------
// exports
// ---------------------------------------------------------

function createExports() {

  if (
    currentClassified === null
  ) {

    statusLabel.setValue(
      'Create a map before exporting.'
    );

    return;
  }


  var siteName =
    siteSelect
      .getValue()
      .replace(/ /g, '_');


  var year =
    yearSelect.getValue();


  var exportScale =
    Number(
      exportScaleSelect.getValue()
    );


  Export.image.toDrive({

    image:
      currentClassified.toByte(),

    description:
      siteName +
      '_LULC_' +
      year,

    fileNamePrefix:
      siteName +
      '_LULC_' +
      year,

    region:
      currentGeom,

    scale:
      exportScale,

    maxPixels:
      1e13,

    fileFormat:
      'GeoTIFF'
  });


  if (
    validationFeatures.length > 0
  ) {

    Export.table.toDrive({

      collection:
        ee.FeatureCollection(
          validationFeatures
        ),

      description:
        siteName +
        '_Reviewed_Validation_' +
        year,

      fileNamePrefix:
        siteName +
        '_Reviewed_Validation_' +
        year,

      fileFormat:
        'CSV'
    });
  }


  if (
    currentMetrics !== null
  ) {

    Export.table.toDrive({

      collection:
        currentMetrics,

      description:
        siteName +
        '_Accuracy_' +
        year,

      fileNamePrefix:
        siteName +
        '_Accuracy_' +
        year,

      fileFormat:
        'CSV'
    });
  }


  statusLabel.setValue(
    'Export tasks created.\n' +
    'Open the Tasks tab in the Earth Engine Code Editor to run them.'
  );
}


